# OpenWeather API Key (for tea prediction weather data)
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AI Provider for real suggestions (choose one or more)
# Recommended: Groq - fast and free tier available at https://console.groq.com/
AI_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Alternative: Hugging Face - https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Alternative: OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
